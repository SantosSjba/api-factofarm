enum InventoryMovementType {
  INGRESO
  SALIDA
  AJUSTE
  TRANSFERENCIA_ENTRADA
  TRANSFERENCIA_SALIDA
}

enum WarehouseZoneType {
  NORMAL
  REFRIGERADO
  CONTROLADO
}

enum InventoryTransferStatus {
  BORRADOR
  EN_TRANSITO
  RECIBIDO
  ANULADO
}

enum InventoryValuationMethod {
  PEPS
  PROMEDIO_PONDERADO
}

enum InventoryLotAllocationMethod {
  FEFO
  FIFO
}

enum InventoryPhysicalCountStatus {
  EN_PROCESO
  FINALIZADO
  ANULADO
}

enum InventoryPendingAdjustmentStatus {
  PENDIENTE
  APROBADO
  RECHAZADO
}

/// Conteo físico / inventario cíclico
model InventoryPhysicalCount {
  id          String                       @id @default(uuid())
  warehouseId String
  userId      String?
  estado      InventoryPhysicalCountStatus @default(EN_PROCESO)
  comentario  String?                      @db.VarChar(500)
  fecha       DateTime                     @default(now())
  deletedAt   DateTime?
  createdAt   DateTime                     @default(now())
  updatedAt   DateTime                     @updatedAt

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  items     InventoryPhysicalCountItem[]

  @@index([warehouseId])
  @@index([estado])
  @@index([deletedAt])
}

model InventoryPhysicalCountItem {
  id           String  @id @default(uuid())
  countId      String
  productId    String
  codigoLote   String?
  stockSistema Decimal @db.Decimal(18, 4)
  stockContado Decimal @db.Decimal(18, 4)

  count   InventoryPhysicalCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  product Product              @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([countId])
  @@index([productId])
}

/// Ajuste que requiere segunda autorización (mermas grandes)
model InventoryPendingAdjustment {
  id               String                         @id @default(uuid())
  productId        String
  warehouseId      String
  codigoLote       String?
  cantidadAjuste   Decimal                        @db.Decimal(18, 4)
  motivo           String                         @db.VarChar(500)
  estado           InventoryPendingAdjustmentStatus @default(PENDIENTE)
  requestedById    String
  approvedById     String?
  approvedAt       DateTime?
  deletedAt        DateTime?
  createdAt        DateTime                       @default(now())
  updatedAt        DateTime                       @updatedAt

  product     Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  requestedBy User      @relation("AdjustmentRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  approvedBy  User?     @relation("AdjustmentApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([estado])
  @@index([warehouseId])
  @@index([requestedById])
  @@index([deletedAt])
}

/// Zona BPA dentro de un almacén (normal, refrigerado, controlado)
model WarehouseZone {
  id          String           @id @default(uuid())
  warehouseId String
  nombre      String
  tipo        WarehouseZoneType @default(NORMAL)
  activo      Boolean          @default(true)
  deletedAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  warehouse       Warehouse                @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  temperatureLogs ColdChainTemperatureLog[]

  @@unique([warehouseId, nombre])
  @@index([warehouseId])
  @@index([deletedAt])
}

/// Registro diario de temperatura — cadena de frío (BPA)
model ColdChainTemperatureLog {
  id              String   @id @default(uuid())
  warehouseZoneId String
  userId          String?
  fecha           DateTime @default(now())
  temperaturaCelsius Decimal @db.Decimal(5, 2)
  observacion     String?  @db.VarChar(500)

  warehouseZone WarehouseZone @relation(fields: [warehouseZoneId], references: [id], onDelete: Cascade)
  user          User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([warehouseZoneId])
  @@index([fecha])
  @@index([userId])
}

/// Transferencia de stock entre almacenes / sucursales
model InventoryStockTransfer {
  id              String                  @id @default(uuid())
  fromWarehouseId String
  toWarehouseId   String
  userId          String?
  estado          InventoryTransferStatus @default(BORRADOR)
  guiaNumero      String?                 @db.VarChar(30)
  comentario      String?                 @db.VarChar(500)
  fechaEnvio      DateTime?
  fechaRecepcion  DateTime?
  deletedAt       DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  fromWarehouse Warehouse @relation("TransferFromWarehouse", fields: [fromWarehouseId], references: [id], onDelete: Restrict)
  toWarehouse   Warehouse @relation("TransferToWarehouse", fields: [toWarehouseId], references: [id], onDelete: Restrict)
  user          User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  items              InventoryStockTransferItem[]
  electronicDocument ElectronicDocument?

  @@index([fromWarehouseId])
  @@index([toWarehouseId])
  @@index([estado])
  @@index([deletedAt])
}

model InventoryStockTransferItem {
  id            String  @id @default(uuid())
  transferId    String
  productId     String
  codigoLote    String?
  cantidad      Decimal @db.Decimal(18, 4)
  costoUnitario Decimal? @db.Decimal(18, 4)

  transfer InventoryStockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product  Product                @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([transferId])
  @@index([productId])
}
