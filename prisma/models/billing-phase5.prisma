enum BillingProviderType {
  MOCK
  NUBEFACT
  FACTILIZA
  BIZLINKS
}

enum SunatDocumentStatus {
  PENDIENTE
  ENVIANDO
  ACEPTADO
  OBSERVADO
  RECHAZADO
  ANULADO
  CONTINGENCIA
}

enum ElectronicDocumentType {
  FACTURA
  BOLETA
  NOTA_CREDITO
  NOTA_DEBITO
  GUIA_REMISION_REMITENTE
  GUIA_REMISION_TRANSPORTISTA
  RETENCION
  PERCEPCION
  NOTA_VENTA
  LIQUIDACION_COMPRA
  RESUMEN_BOLETAS
  COMUNICACION_BAJA
}

enum BillingJobType {
  EMIT
  RETRY
  RESUMEN_BOLETAS
  COMUNICACION_BAJA
}

enum BillingJobStatus {
  PENDIENTE
  PROCESANDO
  COMPLETADO
  FALLIDO
}

model EstablishmentBillingConfig {
  id                           String              @id @default(uuid())
  establishmentId              String              @unique
  provider                     BillingProviderType @default(MOCK)
  rucEmisor                    String?             @db.VarChar(11)
  razonSocialEmisor            String?             @db.VarChar(200)
  apiUrl                       String?             @db.VarChar(500)
  apiTokenEncrypted            String?             @db.Text
  certificateEncrypted         String?             @db.Text
  certificatePasswordEncrypted String?             @db.Text
  modoSandbox                  Boolean             @default(true)
  autoEmitOnSale               Boolean             @default(true)
  consultaApiUrl               String?             @db.VarChar(500)
  emitNotaVenta                Boolean             @default(false)
  applyDetraccion              Boolean             @default(false)
  autoEmitGuiaOnTransfer       Boolean             @default(true)
  createdAt                    DateTime            @default(now())
  updatedAt                    DateTime            @updatedAt

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
}

model ElectronicDocument {
  id                  String                @id @default(uuid())
  establishmentId     String
  saleId              String?               @unique
  documentType        ElectronicDocumentType
  serie               String                @db.VarChar(10)
  numero              String                @db.VarChar(20)
  sunatStatus         SunatDocumentStatus   @default(PENDIENTE)
  subtotal            Decimal               @db.Decimal(18, 4)
  igvTotal            Decimal               @default(0) @db.Decimal(18, 4)
  total               Decimal               @db.Decimal(18, 4)
  moneda              String                @default("PEN") @db.VarChar(3)
  esContingencia      Boolean               @default(false)
  externalId          String?               @db.VarChar(120)
  xmlArchivoId        String?
  pdfArchivoId        String?
  cdrArchivoId        String?
  sunatCodigo         String?               @db.VarChar(20)
  sunatDescripcion    String?               @db.VarChar(500)
  retryCount          Int                   @default(0)
  nextRetryAt         DateTime?
  voidReason          String?               @db.VarChar(500)
  relatedDocumentId   String?
  saleReturnId        String?               @unique
  inventoryTransferId String?               @unique
  customerDocType     String?               @db.VarChar(20)
  customerDocNumber   String?               @db.VarChar(20)
  customerNombre      String?               @db.VarChar(200)
  emittedAt           DateTime?
  deletedAt           DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  establishment   Establishment        @relation(fields: [establishmentId], references: [id], onDelete: Restrict)
  sale            Sale?                @relation(fields: [saleId], references: [id], onDelete: SetNull)
  saleReturn      SaleReturn?          @relation(fields: [saleReturnId], references: [id], onDelete: SetNull)
  inventoryTransfer InventoryStockTransfer? @relation(fields: [inventoryTransferId], references: [id], onDelete: SetNull)
  relatedDocument ElectronicDocument?  @relation("BillingRelatedDoc", fields: [relatedDocumentId], references: [id], onDelete: SetNull)
  derivedDocs     ElectronicDocument[] @relation("BillingRelatedDoc")
  lines           ElectronicDocumentLine[]
  taxLines        ElectronicDocumentTax[]
  responses       SunatResponse[]
  jobs            BillingJob[]
  taxWithholdingRecord TaxWithholdingRecord?

  @@unique([establishmentId, documentType, serie, numero])
  @@index([establishmentId])
  @@index([sunatStatus])
  @@index([createdAt])
  @@index([deletedAt])
}

model ElectronicDocumentLine {
  id                   String  @id @default(uuid())
  electronicDocumentId String
  lineNumber           Int
  descripcion          String  @db.VarChar(500)
  codigoProducto       String? @db.VarChar(60)
  codigoSunat          String? @db.VarChar(20)
  unidadMedida         String  @default("NIU") @db.VarChar(10)
  cantidad             Decimal @db.Decimal(18, 4)
  precioUnitario       Decimal @db.Decimal(18, 4)
  subtotalLinea        Decimal @db.Decimal(18, 4)
  igvLinea             Decimal @default(0) @db.Decimal(18, 4)
  totalLinea           Decimal @db.Decimal(18, 4)
  taxAffectationCodigo String? @db.VarChar(10)
  taxAffectationDesc   String? @db.VarChar(120)

  electronicDocument ElectronicDocument @relation(fields: [electronicDocumentId], references: [id], onDelete: Cascade)

  @@index([electronicDocumentId])
}

model ElectronicDocumentTax {
  id                   String  @id @default(uuid())
  electronicDocumentId String
  taxCodigo            String  @db.VarChar(10)
  taxNombre            String  @db.VarChar(120)
  baseImponible        Decimal @db.Decimal(18, 4)
  monto                Decimal @db.Decimal(18, 4)

  electronicDocument ElectronicDocument @relation(fields: [electronicDocumentId], references: [id], onDelete: Cascade)

  @@index([electronicDocumentId])
}

model SunatResponse {
  id                   String   @id @default(uuid())
  electronicDocumentId String
  tipo                 String   @db.VarChar(40)
  codigo               String?  @db.VarChar(20)
  descripcion          String?  @db.VarChar(500)
  payload              String?  @db.Text
  createdAt            DateTime @default(now())

  electronicDocument ElectronicDocument @relation(fields: [electronicDocumentId], references: [id], onDelete: Cascade)

  @@index([electronicDocumentId])
}

model BillingJob {
  id                   String           @id @default(uuid())
  electronicDocumentId String
  jobType              BillingJobType
  status               BillingJobStatus @default(PENDIENTE)
  attempts             Int              @default(0)
  lastError            String?          @db.VarChar(500)
  scheduledAt          DateTime         @default(now())
  processedAt          DateTime?
  createdAt            DateTime         @default(now())

  electronicDocument ElectronicDocument @relation(fields: [electronicDocumentId], references: [id], onDelete: Cascade)

  @@index([status, scheduledAt])
  @@index([electronicDocumentId])
}
