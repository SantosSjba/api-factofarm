enum SaleVoidRequestStatus {
  PENDIENTE
  APROBADA
  RECHAZADA
}

enum UserLeaveType {
  VACACIONES
  LICENCIA_MEDICA
  PERMISO
  OTRO
}

enum UserLeaveStatus {
  SOLICITADO
  APROBADO
  RECHAZADO
  CANCELADO
}

model SaleVoidRequest {
  id              String                @id @default(uuid())
  establishmentId String
  saleId          String                @unique
  requestedById   String
  approvedById    String?
  reason          String                @db.VarChar(500)
  status          SaleVoidRequestStatus @default(PENDIENTE)
  rejectedReason  String?               @db.VarChar(500)
  resolvedAt      DateTime?
  createdAt       DateTime              @default(now())

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Restrict)
  sale          Sale          @relation(fields: [saleId], references: [id], onDelete: Restrict)
  requestedBy   User          @relation("SaleVoidRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  approvedBy    User?         @relation("SaleVoidApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([establishmentId])
  @@index([status])
  @@index([requestedById])
}

model UserWorkSchedule {
  id        String @id @default(uuid())
  userId    String
  dayOfWeek Int
  startTime String @db.VarChar(5)
  endTime   String @db.VarChar(5)
  activo    Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dayOfWeek])
  @@index([userId])
}

model UserAttendance {
  id              String    @id @default(uuid())
  userId          String
  establishmentId String
  checkInAt       DateTime  @default(now())
  checkOutAt      DateTime?
  notas           String?   @db.VarChar(500)
  createdAt       DateTime  @default(now())

  user          User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([establishmentId])
  @@index([checkInAt])
}

model UserCommissionRule {
  id                String   @id @default(uuid())
  userId            String
  commissionPercent Decimal  @db.Decimal(5, 2)
  activo            Boolean  @default(true)
  effectiveFrom     DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([activo])
}

model UserLeave {
  id        String          @id @default(uuid())
  userId    String
  tipo      UserLeaveType
  estado    UserLeaveStatus @default(SOLICITADO)
  fromDate  DateTime
  toDate    DateTime
  notas     String?         @db.VarChar(500)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([estado])
  @@index([fromDate])
}
