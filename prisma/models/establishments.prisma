enum DocumentSeriesType {
  FACTURA_ELECTRONICA
  BOLETA_VENTA_ELECTRONICA
  NOTA_CREDITO
  NOTA_DEBITO
  GUIA_REMISION_REMITENTE
  COMPROBANTE_RETENCION_ELECTRONICA
  GUIA_REMISION_TRANSPORTISTA
  COMPROBANTE_PERCEPCION_ELECTRONICA
  NOTA_VENTA
  LIQUIDACION_COMPRA
  GUIA_INGRESO_ALMACEN
  GUIA_SALIDA_ALMACEN
  GUIA_TRANSFERENCIA_ALMACEN
}

/// Formato del PDF interno de venta/nota (no aplica al PDF oficial del OSE).
enum SalePdfFormat {
  TICKET_80
  TICKET_58
  A4
}

/// Establecimiento / sucursal asignada al usuario
model Establishment {
  id              String   @id @default(uuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  nombre          String
  codigo          String?  @unique
  activo          Boolean  @default(true)
  pais            String   @default("PERU")
  /// Zona horaria IANA del local (calendario de negocio, PDFs, reportes). Default Perú.
  timeZone        String   @default("America/Lima") @db.VarChar(64)
  departmentId    String?
  provinceId      String?
  districtId      String?
  direccionFiscal String?
  direccionComercial String?
  telefono        String?
  correoContacto  String?
  direccionWeb    String?
  informacionAdicional String?
  urlImpresora    String?
  nombreImpresora String?
  clienteDefault  String?
  logoArchivoId   String?
  /// Formato PDF generado (nota de venta / voucher interno) por local SaaS
  salePdfFormat   SalePdfFormat @default(TICKET_80)
  sujetoIgv31556  Boolean  @default(false)
  esHospital      Boolean  @default(false)
  inventoryValuationMethod InventoryValuationMethod @default(PEPS)
  inventoryLotAllocationMethod InventoryLotAllocationMethod @default(FEFO)
  blockExpiredProductSales Boolean @default(true)
  /// Cantidad absoluta a partir de la cual un ajuste requiere segunda autorización
  adjustmentQtyThreshold Decimal @default(50) @db.Decimal(18, 4)
  /// Número de registro sanitario DIGEMID del establecimiento
  numeroRegistroDigemid String? @db.VarChar(40)
  titularPharmacistLicenseId String?
  blockSalesAboveRegulatedPrice Boolean @default(false)
  /// Número celular Yape del local (solo referencia para cajero / cliente)
  posYapeNumero   String? @db.VarChar(20)
  /// Número celular Plin del local (solo referencia para cajero / cliente)
  posPlinNumero   String? @db.VarChar(20)
  /// WhatsApp del local para avisos delivery (wa.me)
  deliveryWhatsappNumero String? @db.VarChar(20)
  /// Slug público para portal de pedidos web (/public/delivery/{slug})
  deliveryPublicSlug   String? @unique @db.VarChar(60)
  deliveryPortalEnabled Boolean @default(false)
  deliveryNotifyEmailEnabled Boolean @default(true)
  deliveryNotifySmsEnabled   Boolean @default(false)
  /// Puntos por cada S/ 1 de compra (fidelización)
  loyaltyPointsPerSol      Int     @default(1)
  deletedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  department Department? @relation("EstablishmentDepartment", fields: [departmentId], references: [id], onDelete: Restrict)
  province   Province?   @relation("EstablishmentProvince", fields: [provinceId], references: [id], onDelete: Restrict)
  district   District?   @relation("EstablishmentDistrict", fields: [districtId], references: [id], onDelete: Restrict)

  users             User[]
  series            EstablishmentSeries[]
  warehouses        Warehouse[]
  productLocations  ProductLocation[]
  cashRegisters     CashRegister[]
  promotions        Promotion[]
  sales             Sale[]
  quotations        Quotation[]
  purchaseOrders    PurchaseOrder[]
  goodsReceipts     GoodsReceipt[]
  accountPayables   AccountPayable[]
  supplierCreditNotes SupplierCreditNote[]
  billingConfig     EstablishmentBillingConfig?
  electronicDocuments ElectronicDocument[]
  prescriptions     Prescription[]
  controlledLedger  ControlledSubstanceLedgerEntry[]
  adverseEvents     AdverseEvent[]
  taxWithholdingRecords TaxWithholdingRecord[]
  titularPharmacist PharmacistLicense? @relation("EstablishmentTitularPharmacist", fields: [titularPharmacistLicenseId], references: [id], onDelete: SetNull)
  deliveryOrders    DeliveryOrder[]
  loyaltyTransactions CustomerLoyaltyTransaction[]
  agreements          Agreement[]
  accountReceivables  AccountReceivable[]
  hospitalAreas       HospitalArea[]
  hospitalConsumptions HospitalInternalConsumption[]
  bankAccounts        BankAccount[]
  purchaseBudgets     PurchaseBudget[]
  saleVoidRequests    SaleVoidRequest[]
  userAttendances     UserAttendance[]
  shippingCarriers    ShippingCarrier[]
  shippingDrivers     ShippingDriver[]
  shippingVehicles    ShippingVehicle[]
  departureAddresses  DepartureAddress[]

  @@index([titularPharmacistLicenseId])
  @@index([departmentId])
  @@index([provinceId])
  @@index([districtId])
  @@index([tenantId])
  @@index([deletedAt])
}

model EstablishmentSeries {
  id              String             @id @default(uuid())
  establishmentId String
  documentType    DocumentSeriesType
  numero          String
  esContingencia  Boolean            @default(false)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  @@unique([establishmentId, documentType, numero])
  @@index([establishmentId, documentType])
}
