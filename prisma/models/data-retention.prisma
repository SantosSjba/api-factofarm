/// Corridas de jobs de retención / purga (plataforma)
model DataRetentionRun {
  id           String    @id @default(uuid())
  jobName      String    @db.VarChar(80)
  mode         String    @db.VarChar(20)
  cutoffAt     DateTime
  deletedCount Int       @default(0)
  details      Json?
  status       String    @db.VarChar(20)
  errorMessage String?   @db.VarChar(1000)
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?

  @@index([jobName, startedAt])
  @@index([startedAt])
}

/// Cold storage de ventas (Fase 3). No reemplaza la fila hot hasta archivado; nunca se borra el histórico aquí.
model ArchivedSale {
  id                String   @id
  establishmentId   String
  originalCreatedAt DateTime
  archivedAt        DateTime @default(now())
  payload           Json

  @@index([establishmentId, originalCreatedAt])
  @@index([archivedAt])
}

/// Cold storage de movimientos de inventario / kardex (Fase 3).
model ArchivedInventoryInboundMovement {
  id                    String   @id
  warehouseId           String
  productId             String
  originalFechaRegistro DateTime
  archivedAt            DateTime @default(now())
  payload               Json

  @@index([warehouseId, originalFechaRegistro])
  @@index([productId, originalFechaRegistro])
  @@index([archivedAt])
}
