model Laboratory {
  id        String    @id @default(uuid())
  nombre    String    @unique
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([deletedAt])
}

model PharmaceuticalForm {
  id        String    @id @default(uuid())
  nombre    String    @unique
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([deletedAt])
}

model ActivePrinciple {
  id        String    @id @default(uuid())
  nombre    String    @unique
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([deletedAt])
}

model AdministrationRoute {
  id        String    @id @default(uuid())
  nombre    String    @unique
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  products Product[]

  @@index([deletedAt])
}
