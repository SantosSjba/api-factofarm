# =============================================================================
# FactoFarm API — variables de entorno
# Copia: cp .env.example .env
# =============================================================================

# --- Obligatorias ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
JWT_SECRET="cambiar-por-secreto-de-al-menos-32-caracteres-ok"

# --- JWT ---
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7

# --- Servidor ---
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# --- Seguridad producción ---
# Origen principal del frontend (CORS)
FRONTEND_URL=http://localhost:4200
# Producción FactoFarm:
# FRONTEND_URL=https://factofarm.factosysperu.com
# CORS_ORIGINS=https://factofarm.factosysperu.com
# Clave dedicada AES-256 para tokens/certificados OSE (obligatoria en producción)
# Generar: openssl rand -base64 48
# BILLING_ENCRYPTION_KEY=
# Cifrado datos sensibles de salud (LPDP) — obligatoria en producción
# Generar: openssl rand -base64 48
# LPDP_SENSITIVE_ENCRYPTION_KEY=
# Desactivar Swagger en producción (por defecto false si NODE_ENV=production)
SWAGGER_ENABLED=true

# --- Archivos ---
UPLOADS_DIR=uploads
# MinIO / S3 (si están definidos, reemplazan el disco local — I-INF-01)
# S3_ENDPOINT=https://storage.factosysperu.com
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=factofarm
# S3_REGION=us-east-1
# S3_KEY_PREFIX=uploads

# --- Cache (opcional) ---
# CACHE_TTL_MS=300000
# REDIS_URL=redis://localhost:6379

# --- PostgreSQL pool ---
# PG_POOL_MAX=20
# PG_POOL_IDLE_MS=30000
# PG_POOL_CONNECT_MS=10000

# --- Observabilidad (opcional) ---
# SENTRY_DSN=https://example@sentry.io/123

# --- Recuperación contraseña ---
PASSWORD_RESET_EXPIRES_MINUTES=60
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=FactoFarm <contacto@factosysperu.com>

# --- Landing / ventas ---
# Correo que recibe solicitudes de contacto desde la web pública
SALES_CONTACT_EMAIL=contacto@factosysperu.com

# --- Libro de reclamaciones (Ley 29571) ---
COMPLAINTS_EMAIL=contacto@factosysperu.com
COMPANY_LEGAL_NAME=FACTOSYS PERU S.A.C.
COMPANY_RUC=20614608952
COMPANY_ADDRESS=Trujillo, La Libertad, Perú. Atendemos todo el Perú (24 departamentos y Callao).

# --- Rate limiting ---
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
THROTTLE_LOGIN_LIMIT=10

# --- Retención de datos (AuditLog hard purge) ---
# DATA_RETENTION_AUDIT_DAYS=730
# DATA_RETENTION_PURGE_ENABLED=false
# Soft-protect: además de ENABLED, exige este token exacto (B-LOG-20)
# DATA_RETENTION_PURGE_CONFIRM=I_UNDERSTAND
# DATA_RETENTION_ARCHIVE_ENABLED=false

# --- URLs útiles (dev) ---
# Health:     http://localhost:3000/api/health
# Ready:      http://localhost:3000/api/v1/health/ready
# API:        http://localhost:3000/api/v1
# Docs:       http://localhost:3000/api/v1/docs
