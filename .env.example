# =============================================================================
# FactoFarm API — variables de entorno
# Copia: cp .env.example .env
# =============================================================================

# --- Obligatorias ---
# PostgreSQL (Prisma Migrate + runtime). Neon, local, etc.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Firma JWT (mínimo 32 caracteres). Genera uno seguro en producción:
# openssl rand -base64 48
JWT_SECRET="cambiar-por-secreto-de-al-menos-32-caracteres-ok"

# --- JWT (opcionales, tienen default en env.validation.ts) ---
# Duración del access token (ej. 15m, 1h)
JWT_ACCESS_EXPIRES_IN=15m
# Legacy / fallback si no hay JWT_ACCESS_EXPIRES_IN
# JWT_EXPIRES_IN=7d
# Días de validez del refresh token (1–90)
JWT_REFRESH_EXPIRES_DAYS=7

# --- Servidor ---
NODE_ENV=development
PORT=3000
# 0.0.0.0 = escucha en todas las interfaces; 127.0.0.1 solo local
HOST=0.0.0.0

# --- Archivos subidos (fotos de perfil, logos, etc.) ---
UPLOADS_DIR=uploads

# --- Recuperación de contraseña ---
FRONTEND_URL=http://localhost:4200
PASSWORD_RESET_EXPIRES_MINUTES=60
# Sin SMTP_HOST el enlace se imprime en logs del API (desarrollo)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=FactoFarm <noreply@tu-dominio.com>

# --- Rate limiting (@nestjs/throttler) ---
# Ventana global en milisegundos y máximo de peticiones por IP
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
# Límite estricto solo en POST /auth/login (por IP)
THROTTLE_LOGIN_LIMIT=10

# --- URLs útiles (dev) ---
# Health:     http://localhost:3000/api/health
# API:        http://localhost:3000/api/v1
# Docs:       http://localhost:3000/api/v1/docs
# OpenAPI:    http://localhost:3000/api/v1/openapi.json
# Frontend:   http://localhost:4200  (apiBaseUrl en environment.development.ts)
